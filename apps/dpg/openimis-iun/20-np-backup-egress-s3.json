{
    "apiVersion":  "networking.k8s.io/v1",
    "kind":  "NetworkPolicy",
    "metadata":  {
                     "name":  "allow-egress-backup-to-s3",
                     "namespace":  "iun-openimis-dev",
                     "labels":  null
                 },
    "spec":  {
                 "egress":  [
                                {
                                    "to":  [
                                               {
                                                   "namespaceSelector":  {
                                                                             "matchLabels":  {
                                                                                                 "kubernetes.io/metadata.name":  "openshift-storage"
                                                                                             }
                                                                         }
                                               }
                                           ]
                                }
                            ],
                 "podSelector":  {
                                     "matchLabels":  {
                                                         "iun.sn/backup":  "true"
                                                     }
                                 },
                 "policyTypes":  [
                                     "Egress"
                                 ]
             }
}