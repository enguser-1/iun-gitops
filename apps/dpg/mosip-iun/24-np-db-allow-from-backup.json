{
    "apiVersion":  "networking.k8s.io/v1",
    "kind":  "NetworkPolicy",
    "metadata":  {
                     "name":  "db-allow-from-backup",
                     "namespace":  "iun-mosip-dev",
                     "labels":  null
                 },
    "spec":  {
                 "ingress":  [
                                 {
                                     "from":  [
                                                  {
                                                      "podSelector":  {
                                                                          "matchLabels":  {
                                                                                              "iun.sn/backup":  "true"
                                                                                          }
                                                                      }
                                                  }
                                              ],
                                     "ports":  [
                                                   {
                                                       "port":  5432,
                                                       "protocol":  "TCP"
                                                   }
                                               ]
                                 }
                             ],
                 "podSelector":  {
                                     "matchLabels":  {
                                                         "cnpg.io/cluster":  "mosip-postgres"
                                                     }
                                 },
                 "policyTypes":  [
                                     "Ingress"
                                 ]
             }
}