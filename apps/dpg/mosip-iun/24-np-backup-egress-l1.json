{
    "apiVersion":  "networking.k8s.io/v1",
    "kind":  "NetworkPolicy",
    "metadata":  {
                     "name":  "allow-egress-backup-to-l1",
                     "namespace":  "iun-mosip-dev",
                     "labels":  null
                 },
    "spec":  {
                 "egress":  [
                                {
                                    "ports":  [
                                                  {
                                                      "port":  443,
                                                      "protocol":  "TCP"
                                                  }
                                              ],
                                    "to":  [
                                               {
                                                   "ipBlock":  {
                                                                   "cidr":  "0.0.0.0/0"
                                                               }
                                               }
                                           ]
                                },
                                {
                                    "ports":  [
                                                  {
                                                      "port":  5432,
                                                      "protocol":  "TCP"
                                                  }
                                              ],
                                    "to":  [
                                               {
                                                   "podSelector":  {
                                                                       "matchLabels":  {
                                                                                           "cnpg.io/cluster":  "mosip-postgres"
                                                                                       }
                                                                   }
                                               }
                                           ]
                                },
                                {
                                    "ports":  [
                                                  {
                                                      "port":  5353,
                                                      "protocol":  "UDP"
                                                  },
                                                  {
                                                      "port":  53,
                                                      "protocol":  "UDP"
                                                  },
                                                  {
                                                      "port":  53,
                                                      "protocol":  "TCP"
                                                  }
                                              ],
                                    "to":  [
                                               {
                                                   "namespaceSelector":  {
                                                                             "matchLabels":  {
                                                                                                 "kubernetes.io/metadata.name":  "openshift-dns"
                                                                                             }
                                                                         }
                                               }
                                           ]
                                }
                            ],
                 "podSelector":  {
                                     "matchLabels":  {
                                                         "iun.sn/backup":  "true"
                                                     }
                                 },
                 "policyTypes":  [
                                     "Egress"
                                 ]
             }
}