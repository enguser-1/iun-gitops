{
    "apiVersion":  "batch/v1",
    "kind":  "CronJob",
    "metadata":  {
                     "name":  "backup-direct-l1-hearth",
                     "namespace":  "iun-opencrvs-dev",
                     "labels":  null
                 },
    "spec":  {
                 "concurrencyPolicy":  "Forbid",
                 "failedJobsHistoryLimit":  3,
                 "jobTemplate":  {
                                     "metadata":  {
                                                      "creationTimestamp":  null
                                                  },
                                     "spec":  {
                                                  "activeDeadlineSeconds":  1800,
                                                  "backoffLimit":  1,
                                                  "template":  {
                                                                   "metadata":  {
                                                                                    "creationTimestamp":  null,
                                                                                    "labels":  {
                                                                                                   "iun.sn/backup":  "true"
                                                                                               }
                                                                                },
                                                                   "spec":  {
                                                                                "containers":  [
                                                                                                   {
                                                                                                       "command":  [
                                                                                                                       "sh",
                                                                                                                       "-c",
                                                                                                                       "set -e; ls -lh /backup/; for f in /backup/*; do [ -e \"$f\" ] || continue; AWS_ACCESS_KEY_ID=\"$L1_ACCESS_KEY\" AWS_SECRET_ACCESS_KEY=\"$L1_SECRET_KEY\" aws --endpoint-url \"$L1_S3_ENDPOINT\" --no-verify-ssl s3 cp \"$f\" \"s3://$L1_BUCKET/origins-opencrvs/direct/$(basename $f)\" 2\u003e/dev/null; done; echo DIRECT-L1-OK"
                                                                                                                   ],
                                                                                                       "envFrom":  [
                                                                                                                       {
                                                                                                                           "secretRef":  {
                                                                                                                                             "name":  "iun-dr-s3"
                                                                                                                                         }
                                                                                                                       }
                                                                                                                   ],
                                                                                                       "image":  "amazon/aws-cli:2.17.16",
                                                                                                       "imagePullPolicy":  "IfNotPresent",
                                                                                                       "name":  "upload-l1",
                                                                                                       "resources":  {

                                                                                                                     },
                                                                                                       "terminationMessagePath":  "/dev/termination-log",
                                                                                                       "terminationMessagePolicy":  "File",
                                                                                                       "volumeMounts":  [
                                                                                                                            {
                                                                                                                                "mountPath":  "/backup",
                                                                                                                                "name":  "backup"
                                                                                                                            }
                                                                                                                        ]
                                                                                                   }
                                                                                               ],
                                                                                "dnsPolicy":  "ClusterFirst",
                                                                                "initContainers":  [
                                                                                                       {
                                                                                                           "command":  [
                                                                                                                           "bash",
                                                                                                                           "-c",
                                                                                                                           "set -euo pipefail\nSTAMP=$(date -u +%Y%m%d-%H%M%S)\nmongodump --uri=\"mongodb://$MONGO_ROOT_USER:$MONGO_ROOT_PASSWORD@mongo:27017/?authSource=admin\" --archive=/backup/hearth-full-$STAMP.archive.gz --gzip\nls -lh /backup/"
                                                                                                                       ],
                                                                                                           "env":  [
                                                                                                                       {
                                                                                                                           "name":  "MONGO_ROOT_USER",
                                                                                                                           "valueFrom":  {
                                                                                                                                             "secretKeyRef":  {
                                                                                                                                                                  "key":  "root-username",
                                                                                                                                                                  "name":  "mongodb-creds"
                                                                                                                                                              }
                                                                                                                                         }
                                                                                                                       },
                                                                                                                       {
                                                                                                                           "name":  "MONGO_ROOT_PASSWORD",
                                                                                                                           "valueFrom":  {
                                                                                                                                             "secretKeyRef":  {
                                                                                                                                                                  "key":  "root-password",
                                                                                                                                                                  "name":  "mongodb-creds"
                                                                                                                                                              }
                                                                                                                                         }
                                                                                                                       }
                                                                                                                   ],
                                                                                                           "image":  "mongo:6.0",
                                                                                                           "imagePullPolicy":  "IfNotPresent",
                                                                                                           "name":  "dump",
                                                                                                           "resources":  {
                                                                                                                             "limits":  {
                                                                                                                                            "cpu":  "500m",
                                                                                                                                            "memory":  "1Gi"
                                                                                                                                        },
                                                                                                                             "requests":  {
                                                                                                                                              "cpu":  "100m",
                                                                                                                                              "memory":  "256Mi"
                                                                                                                                          }
                                                                                                                         },
                                                                                                           "terminationMessagePath":  "/dev/termination-log",
                                                                                                           "terminationMessagePolicy":  "File",
                                                                                                           "volumeMounts":  [
                                                                                                                                {
                                                                                                                                    "mountPath":  "/backup",
                                                                                                                                    "name":  "backup"
                                                                                                                                }
                                                                                                                            ]
                                                                                                       }
                                                                                                   ],
                                                                                "restartPolicy":  "Never",
                                                                                "schedulerName":  "default-scheduler",
                                                                                "securityContext":  {

                                                                                                    },
                                                                                "terminationGracePeriodSeconds":  30,
                                                                                "volumes":  [
                                                                                                {
                                                                                                    "emptyDir":  {
                                                                                                                     "sizeLimit":  "5Gi"
                                                                                                                 },
                                                                                                    "name":  "backup"
                                                                                                }
                                                                                            ]
                                                                            }
                                                               }
                                              }
                                 },
                 "schedule":  "0 4 * * *",
                 "successfulJobsHistoryLimit":  3,
                 "suspend":  false
             }
}