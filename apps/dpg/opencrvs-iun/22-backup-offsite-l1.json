{
    "apiVersion":  "batch/v1",
    "kind":  "CronJob",
    "metadata":  {
                     "name":  "backup-offsite-l1",
                     "namespace":  "iun-opencrvs-dev",
                     "labels":  null
                 },
    "spec":  {
                 "concurrencyPolicy":  "Forbid",
                 "failedJobsHistoryLimit":  3,
                 "jobTemplate":  {
                                     "metadata":  {
                                                      "creationTimestamp":  null
                                                  },
                                     "spec":  {
                                                  "activeDeadlineSeconds":  1800,
                                                  "backoffLimit":  2,
                                                  "template":  {
                                                                   "metadata":  {
                                                                                    "creationTimestamp":  null,
                                                                                    "labels":  {
                                                                                                   "iun.sn/backup":  "true"
                                                                                               }
                                                                                },
                                                                   "spec":  {
                                                                                "containers":  [
                                                                                                   {
                                                                                                       "command":  [
                                                                                                                       "sh",
                                                                                                                       "-c",
                                                                                                                       "mkdir -p /tmp/mirror; echo [1/2] pull; aws --endpoint-url http://s3.openshift-storage.svc s3 sync \"s3://$BUCKET_NAME\" /tmp/mirror --exclude \"*/\" || echo WARN-PULL-PARTIEL; echo [2/2] push L1; AWS_ACCESS_KEY_ID=\"$L1_ACCESS_KEY\" AWS_SECRET_ACCESS_KEY=\"$L1_SECRET_KEY\" aws --endpoint-url \"$L1_S3_ENDPOINT\" --no-verify-ssl s3 sync /tmp/mirror \"s3://$L1_BUCKET/$OFFSITE_PREFIX/\" \u0026\u0026 echo OFFSITE-OK"
                                                                                                                   ],
                                                                                                       "env":  [
                                                                                                                   {
                                                                                                                       "name":  "OFFSITE_PREFIX",
                                                                                                                       "value":  "origins-opencrvs"
                                                                                                                   }
                                                                                                               ],
                                                                                                       "envFrom":  [
                                                                                                                       {
                                                                                                                           "secretRef":  {
                                                                                                                                             "name":  "iun-backups"
                                                                                                                                         }
                                                                                                                       },
                                                                                                                       {
                                                                                                                           "configMapRef":  {
                                                                                                                                                "name":  "iun-backups"
                                                                                                                                            }
                                                                                                                       },
                                                                                                                       {
                                                                                                                           "secretRef":  {
                                                                                                                                             "name":  "iun-dr-s3"
                                                                                                                                         }
                                                                                                                       }
                                                                                                                   ],
                                                                                                       "image":  "amazon/aws-cli:2.17.16",
                                                                                                       "imagePullPolicy":  "IfNotPresent",
                                                                                                       "name":  "sync",
                                                                                                       "resources":  {

                                                                                                                     },
                                                                                                       "terminationMessagePath":  "/dev/termination-log",
                                                                                                       "terminationMessagePolicy":  "File"
                                                                                                   }
                                                                                               ],
                                                                                "dnsPolicy":  "ClusterFirst",
                                                                                "restartPolicy":  "Never",
                                                                                "schedulerName":  "default-scheduler",
                                                                                "securityContext":  {

                                                                                                    },
                                                                                "terminationGracePeriodSeconds":  30
                                                                            }
                                                               }
                                              }
                                 },
                 "schedule":  "0 3 * * *",
                 "successfulJobsHistoryLimit":  3,
                 "suspend":  false
             }
}