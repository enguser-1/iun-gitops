# ============================================================================
# gateway.yaml — OpenCRVS gateway service (port 7070, GraphQL API)
# ----------------------------------------------------------------------------
# Purpose      : single GraphQL entry point for the client app. Federates
#                queries to auth, search, workflow, config, user-mgnt.
# Dependencies : ALL upstream services Ready (auth, user-mgnt, search,
#                workflow, config, documents, notification, registration).
# Override     : Fallback image docker.io/opencrvs/ocrvs-gateway:v1.9.13.
# Gotchas      :
#   - PITFALLS #7 — JWT in Authorization header can exceed 8 KiB ; if 502
#     starts on auth endpoints, patch the IngressController with bufferSize.
# ============================================================================
apiVersion: v1
kind: Service
metadata:
  name: gateway
  namespace: iun-opencrvs-dev
  labels:
    app.kubernetes.io/name: gateway
    app.kubernetes.io/component: opencrvs
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 7070
      targetPort: 7070
      protocol: TCP
  selector:
    app.kubernetes.io/name: gateway
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gateway
  namespace: iun-opencrvs-dev
  labels:
    app.kubernetes.io/name: gateway
    app.kubernetes.io/component: opencrvs
  annotations:
    iun.sn/image-tag-verified: "2026-06-03 — ghcr.io/opencrvs/ocrvs-gateway:v1.9.13"
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: gateway
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gateway
        app.kubernetes.io/component: opencrvs
      annotations:
        openshift.io/required-scc: iun-anyuid-caps
    spec:
      serviceAccountName: default
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      containers:
        - name: gateway
          image: ghcr.io/opencrvs/ocrvs-gateway:v1.9.13
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 7070
              protocol: TCP
          env:
            - name: NODE_ENV
              value: "development"
            - name: HOST
              value: "0.0.0.0"
            - name: PORT
              value: "7070"
            - name: AUTH_URL
              value: "http://auth:4040"
            - name: USER_MANAGEMENT_URL
              value: "http://user-mgnt:3030"
            - name: SEARCH_URL
              value: "http://search:9090"
            - name: WORKFLOW_URL
              value: "http://workflow:5050"
            - name: CONFIG_URL
              value: "http://config:2021"
            - name: DOCUMENTS_URL
              value: "http://documents:9050"
            - name: NOTIFICATION_URL
              value: "http://notification:2020"
            - name: COUNTRY_CONFIG_URL
              value: "http://countryconfig:3040"
            - name: METRICS_URL
              value: "http://metrics:1050"
            - name: REGISTRATION_URL
              value: "http://registration:3040"
            - name: APPLICATION_CONFIG_URL
              value: "http://config:2021"
            - name: HEARTH_URL
              value: "http://hearth:3447/fhir"
            - name: CERT_PUBLIC_KEY_PATH
              value: "/secrets/jwt-public.pem"
          volumeMounts:
            - name: jwt-keys
              mountPath: /secrets
              readOnly: true
          readinessProbe:
            httpGet:
              path: /ping
              port: 7070
            initialDelaySeconds: 20
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /ping
              port: 7070
            initialDelaySeconds: 60
            periodSeconds: 20
            timeoutSeconds: 5
            failureThreshold: 6
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
      volumes:
        - name: jwt-keys
          secret:
            secretName: jwt-keys
            defaultMode: 0400
