# ============================================================================
# workflow.yaml — OpenCRVS workflow service (port 5050)
# ----------------------------------------------------------------------------
# Purpose      : declare / validate / register / certify state transitions.
#                Emits BIRTH_REGISTERED webhook on register transition.
# Dependencies : Hearth Ready, Mongo (events DB), search, webhooks.
# Override     : Fallback image docker.io/opencrvs/ocrvs-workflow:v1.9.13.
# Gotchas      :
#   - The BIRTH_REGISTERED event is routed by webhooks service to the
#     mosip-api middleware (which then calls iun-uin-service for the UIN).
# ============================================================================
apiVersion: v1
kind: Service
metadata:
  name: workflow
  namespace: iun-opencrvs-dev
  labels:
    app.kubernetes.io/name: workflow
    app.kubernetes.io/component: opencrvs
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 5050
      targetPort: 5050
      protocol: TCP
  selector:
    app.kubernetes.io/name: workflow
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: workflow
  namespace: iun-opencrvs-dev
  labels:
    app.kubernetes.io/name: workflow
    app.kubernetes.io/component: opencrvs
  annotations:
    iun.sn/image-tag-verified: "2026-06-03 — ghcr.io/opencrvs/ocrvs-workflow:v1.9.13"
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: workflow
  template:
    metadata:
      labels:
        app.kubernetes.io/name: workflow
        app.kubernetes.io/component: opencrvs
      annotations:
        openshift.io/required-scc: iun-anyuid-caps
    spec:
      serviceAccountName: default
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      containers:
        - name: workflow
          image: ghcr.io/opencrvs/ocrvs-workflow:v1.9.13
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 5050
              protocol: TCP
          env:
            - name: NODE_ENV
              value: "development"
            - name: HOST
              value: "0.0.0.0"
            - name: PORT
              value: "5050"
            - name: MONGO_APP_USER
              valueFrom: { secretKeyRef: { name: mongodb-creds, key: app-username } }
            - name: MONGO_APP_PASSWORD
              valueFrom: { secretKeyRef: { name: mongodb-creds, key: app-password } }
            - name: MONGO_URL
              value: "mongodb://$(MONGO_APP_USER):$(MONGO_APP_PASSWORD)@mongo-headless:27017/events"
            - name: HEARTH_URL
              value: "http://hearth:3447/fhir"
            - name: AUTH_URL
              value: "http://auth:4040"
            - name: USER_MANAGEMENT_URL
              value: "http://user-mgnt:3030"
            - name: SEARCH_URL
              value: "http://search:9090"
            - name: WEBHOOKS_URL
              value: "http://webhooks:2525"
            - name: NOTIFICATION_URL
              value: "http://notification:2020"
            - name: METRICS_URL
              value: "http://metrics:1050"
            - name: COUNTRY_CONFIG_URL
              value: "http://countryconfig:3040"
            - name: CERT_PUBLIC_KEY_PATH
              value: "/secrets/jwt-public.pem"
          volumeMounts:
            - name: jwt-keys
              mountPath: /secrets
              readOnly: true
          readinessProbe:
            httpGet:
              path: /ping
              port: 5050
            initialDelaySeconds: 20
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /ping
              port: 5050
            initialDelaySeconds: 60
            periodSeconds: 20
            timeoutSeconds: 5
            failureThreshold: 6
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
      volumes:
        - name: jwt-keys
          secret:
            secretName: jwt-keys
            defaultMode: 0400
